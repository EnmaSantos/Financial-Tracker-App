# Supabase Postgres for Prisma
# Use the pooled URL for app/runtime connections and DIRECT_URL for Prisma CLI work.

DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres"
