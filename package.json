{
  "name": "ledger",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ledger/db exec prisma generate",
    "db:migrate": "pnpm --filter @ledger/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @ledger/db exec tsx prisma/seed.ts",
    "db:reset": "pnpm --filter @ledger/db exec prisma migrate reset --force"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
